# Copy to .env.local and fill in REAL values. Anything left empty is hidden in the UI.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_ADDRESS=
# POST endpoint that accepts the enquiry JSON (Formspree, your API, etc.). Without it the form reports failure honestly.
VITE_FORM_ENDPOINT=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=

# Search engine verification and analytics (all optional; tags are only added when set)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_GA_MEASUREMENT_ID=
